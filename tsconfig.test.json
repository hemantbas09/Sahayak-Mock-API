{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": false,
    "outDir": "dist-test",
    "rootDir": ".",
    "noEmit": false,
    "types": ["node"]
  },
  "include": [
    "src/server/**/*.ts",
    "src/lib/**/*.ts",
    "src/types.ts",
    "test/**/*.ts"
  ]
}
