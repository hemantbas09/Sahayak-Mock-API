# Sahayak backend configuration — copy to .env and adjust.

# HTTP (main config API + static frontend + optional path routing)
PORT=4000
HOST=0.0.0.0

# MongoDB (primary storage). When unset/unreachable → local file storage fallback.
MONGODB_URI=mongodb://127.0.0.1:27017/sahayak

# Local file storage fallback (dev convenience; one JSON file per env)
DATA_DIR=./data

# Base directory for FILE responses and TLS cert paths (§1 deviation 2)
FILES_DIR=./data/files

# Auth (§2.7). AUTH_ENABLED=false disables auth (dev shortcut, admin passthrough).
AUTH_ENABLED=true
JWT_SECRET=change-me-in-production
# Seed admin created on first boot when no users exist (email:password)
SEED_ADMIN=admin@example.com:admin1234

# Strict /api CORS allowlist (comma-separated origins). Empty = same-origin only.
APP_URLS=http://localhost:4200

# Optional: serve the built Angular app (after `npm run build` in frontend/)
FRONTEND_DIST=../frontend/dist/sahayak/browser

# Also serve ANY /mock/:uuid/* on the main port (for networks that block
# per-env ports). Mockoon-parity per-env ports remain the default.
PATH_ROUTING=false
