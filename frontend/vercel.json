{
  "outputDirectory": "dist/sahayak/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://sahayak-mock-api.onrender.com/api/:path*"
    },
    {
      "source": "/mock/:path*",
      "destination": "https://sahayak-mock-api.onrender.com/mock/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
