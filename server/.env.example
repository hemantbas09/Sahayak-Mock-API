# Sahayak server configuration - copy to .env and adjust.

# HTTP
PORT=4000
HOST=0.0.0.0

# MongoDB (primary storage). When unset or unreachable, the server falls
# back to local file storage (dev convenience only).
MONGODB_URI=mongodb://127.0.0.1:27017/sahayak

# Local file storage fallback
DATA_DIR=./data
DATA_FILE=./data/mock-config.json

# Optional: serve the built Angular app from this directory
# (e.g. ../dist/sahayak/browser after `npm run build` in the frontend).
FRONTEND_DIST=
