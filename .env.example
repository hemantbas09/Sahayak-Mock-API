# ---------------------------------------------------------------------------
# API Mock Server - environment variables (all optional)
# ---------------------------------------------------------------------------

# PORT: Port the server listens on.
PORT="3000"

# HOST: Interface to bind.
HOST="0.0.0.0"

# APP_URL: The public URL where this app is hosted (used for generated
# mock URLs in the UI). Leave blank for local development.
APP_URL=""

# FIREBASE_SERVICE_ACCOUNT_JSON: Optional. When set, configuration is
# persisted to Cloud Firestore (Admin SDK). When unset, the server persists
# to a local JSON file (DATA_FILE) instead, so the app works out of the box.
# Paste the service account JSON as a single-line string or base64-encoded.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# FIRESTORE_DATABASE_ID: Optional. Only set this if you created a named
# Firestore database. Leave blank to use the project's default database.
FIRESTORE_DATABASE_ID=""

# DATA_FILE: Where the local file storage backend writes configuration.
# Defaults to <project>/data/mock-config.json.
DATA_FILE=""

# DISABLE_HMR: Set to "true" to disable Vite HMR / file watching.
DISABLE_HMR=""
