rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Configuration is managed exclusively by the mock server via the
    // Firebase Admin SDK (service account), which bypasses these rules.
    // Client access is disabled: anyone holding the web app id can no
    // longer read or tamper with the mock configuration.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
